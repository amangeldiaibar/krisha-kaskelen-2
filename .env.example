# 2GIS key. Used only on the server.
DGIS_API_KEY=
# Free AI moderation through Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Paid alternative: Claude. Used only when GEMINI_API_KEY is empty.
ANTHROPIC_API_KEY=
# Optional moderation model override.
MODERATION_MODEL=
# SerpAPI key for importing public Google results. Needed only for npm run import.
SERPAPI_KEY=
# Optional Telegram import. Get these at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Optional comma-separated channel usernames. Empty means search by keywords.
TELEGRAM_CHANNELS=
PORT=3000
