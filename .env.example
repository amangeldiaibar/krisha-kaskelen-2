# PostgreSQL connection string. Empty means the local server from npm run db.
# Example for a hosted server: postgres://user:password@host:5432/dbname
DATABASE_URL=
# 2GIS key. Used only on the server.
DGIS_API_KEY=
# Free AI moderation through Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional moderation model override.
MODERATION_MODEL=
# Optional Telegram import. Get these at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Optional comma-separated channel usernames. Empty means search by keywords.
TELEGRAM_CHANNELS=
# Channels about all of Almaty: only posts naming Kaskelen or a village between it and Almaty are read.
TELEGRAM_AREA_CHANNELS=
# Optional mail for "Forgot password". Without it the reset link is printed in the server terminal.
# Gmail: create an app password (Google account > Security > App passwords), then
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=
# The site's address used in letters. Locally it is http://localhost:5173.
PUBLIC_URL=
# Optional SMS for confirming phone numbers, through Mobizon (mobizon.kz). Without it the code is printed in the server terminal.
MOBIZON_API_KEY=
# The API address from your Mobizon account, if it is not api.mobizon.kz.
MOBIZON_API_URL=
PORT=3000
