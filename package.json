{
  "name": "krisha-kaskelen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "npm run build && node server/index.js",
    "seed": "node server/seed.js",
    "import": "node server/import-cli.js",
    "telegram:login": "node server/telegram-login.js",
    "telegram:qr": "node server/telegram-qr.js",
    "import:telegram": "node server/telegram-import.js",
    "test": "node --test \"server/test/*.test.js\" && vitest run --config client/vite.config.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.32.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "multer": "^2.5.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
