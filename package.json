{
  "name": "krisha-kaskelen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n db,api,web \"node server/local-db.js\" \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "npm run build && concurrently -n db,site --kill-others-on-fail \"node server/local-db.js\" \"node server/index.js\"",
    "db": "node server/local-db.js",
    "db:import-sqlite": "node server/sqlite-to-postgres.js",
    "telegram:login": "node server/telegram-login.js",
    "telegram:qr": "node server/telegram-qr.js",
    "import:telegram": "node server/telegram-import.js",
    "import:krisha": "node server/krisha-csv-import.js",
    "import:krisha-parser": "node server/krisha-parser-import.js",
    "admin": "node server/make-admin.js",
    "test": "node --test \"server/test/*.test.js\" && vitest run --config client/vite.config.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "concurrently": "^9.2.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "leaflet": "^1.9.4",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
